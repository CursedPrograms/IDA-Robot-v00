<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for IDA, sampled from images/ida_avatar.jpg.
  Avatar palette: golden hair, autumn leaves, sage sky.
  Used by the GitHub Pages site (index.html) and any UI that loads it.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#090B10"/>  <!-- window / page background -->
  <colour name="panel"            value="#11141D"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#22293A"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#191D2A"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#F2EDE9"/>  <!-- primary text -->
  <colour name="text_sec"         value="#A89D94"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#6B6057"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#D6935A"/>  <!-- logo, links, selected / hover -->
  <colour name="accent_hover"     value="#E2B38B"/>  <!-- lighter accent: values, connected dot -->
  <colour name="accent2"          value="#B9604D"/>  <!-- second avatar colour: highlights, tags -->
  <colour name="accent3"          value="#EFD68C"/>  <!-- third avatar colour -->

  <!-- Buttons -->
  <colour name="button_hover_bg"  value="#25190E"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#210F0D"/>  <!-- STOP button fill -->
</colour_scheme>
